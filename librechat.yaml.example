version: 1.2.1
endpoints:
  custom:
    - name: AgentCore
      apiKey: local-poc-placeholder
      baseURL: http://127.0.0.1:3081/v1
      models:
        default:
          - agentcore-nova-2-lite
      fetch: false
    - name: Codex Subscription (EC2)
      apiKey: local-poc-placeholder
      baseURL: http://127.0.0.1:3081/codex/v1
      models:
        default:
          - gpt-5.6-luna-low
          - gpt-5.6-luna-medium
          - gpt-5.6-luna-high
          - gpt-5.6-terra-low
          - gpt-5.6-terra-medium
          - gpt-5.6-terra-high
          - gpt-5.6-sol-low
          - gpt-5.6-sol-medium
          - gpt-5.6-sol-high
      fetch: false
    - name: GovTechAI
      apiKey: local-poc-placeholder
      baseURL: http://127.0.0.1:3081/govtech/v1
      models:
        default:
          - gpt-5.6-luna
          - azure.claude-haiku-4-5
          - gemini-3.5-flash
      fetch: false
